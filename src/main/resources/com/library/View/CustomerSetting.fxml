<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="settingRoot" prefHeight="710.0" prefWidth="954.0" style="-fx-background-color: F5ECD5;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.Controller.CustomerSettingController">
    <children>
        <Pane layoutX="34.0" layoutY="93.0" prefHeight="180.0" prefWidth="705.0" style="-fx-background-color: F0BB78; -fx-background-radius: 20px; -fx-padding: 20px;">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0" />
                    </children>
                </VBox>
                  <HBox alignment="CENTER_LEFT" layoutY="124.0" spacing="10.0" />
                    <Label fx:id="phoneNumberLabel" layoutX="19.0" layoutY="77.0" text="Phone Number Here">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>
                    <Label fx:id="userNameLabel" layoutX="19.0" layoutY="34.0" text="User Name Here">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>
                             <Label fx:id="gmailLabel" layoutX="19.0" layoutY="111.0" text="Email Here">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>
            </children>
        </Pane>

        <VBox alignment="TOP_CENTER" layoutX="760.0" layoutY="41.0" spacing="10.0">
            <children>
                <Pane prefHeight="200.0" prefWidth="150.0" style="-fx-background-color: #dedede; -fx-border-color: #cccccc;">
                    <children>
                        <ImageView fx:id="avatarImage" fitHeight="200.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </Pane>
                <Button fx:id="changeAvatarButton" mnemonicParsing="false" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #A4B465; -fx-text-fill: white;" text="Change Avatar">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </children>
        </VBox>

        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="30.0" layoutY="30.0" prefHeight="38.0" prefWidth="900.0" text="Account Settings" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <VBox layoutX="34.0" layoutY="290.0" prefWidth="705.0" spacing="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="150.0" text="New Full Name:">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <TextField fx:id="changeNameField" prefHeight="30.0" promptText="Enter new full name" HBox.hgrow="ALWAYS" />
                        <Button fx:id="changeNameButton" mnemonicParsing="false" style="-fx-background-color: F0BB78;" text="Change">
                            <font><Font size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="150.0" text="New Phone Number:">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <TextField fx:id="changePhoneNumberField" prefHeight="30.0" promptText="Enter new phone number" HBox.hgrow="ALWAYS" />
                        <Button fx:id="changePhoneNumberButton" mnemonicParsing="false" style="-fx-background-color: F0BB78;" text="Change">
                            <font><Font size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="150.0" text="New Email:">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <TextField fx:id="changeGmailField" prefHeight="30.0" promptText="Enter new email" HBox.hgrow="ALWAYS" />
                        <Button fx:id="changeGmailButton" mnemonicParsing="false" style="-fx-background-color: F0BB78;" text="Change">
                            <font><Font size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox layoutX="34.0" layoutY="480.0" prefWidth="705.0" spacing="10.0">
            <children>
                <Label text="Change Password:">
                    <font><Font name="System Bold" size="19.0" /></font>
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="180.0" text="Current Password:">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <PasswordField fx:id="oldPasswordField" prefHeight="30.0" promptText="Enter current password" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="180.0" text="New Password:">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <PasswordField fx:id="newPasswordField" prefHeight="30.0" promptText="Enter new password" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="180.0" text="Confirm New Password:">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <PasswordField fx:id="confirmPasswordField" prefHeight="30.0" promptText="Confirm new password" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <Button fx:id="changePasswordButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: F0BB78;" text="Change Password">
                    <font><Font name="System Bold" size="14.0" /></font>
                    <VBox.margin>
                        <Insets left="292.5" top="10.0" /> </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>
